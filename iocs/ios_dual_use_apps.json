{
  "version": "2026.09.23",
  "description": "Curated App Store apps that can be used to watch a person: location sharing, parental control, couple trackers, anti-theft/remote-access, and apps marketed as phone monitoring. Most have legitimate uses. A match is a prompt to ask \"did I install this and do I know who can see it?\", never a verdict. Bundle IDs, names, and developers were read from Apple's public iTunes Lookup API on the retrieval date; categories and roles were assigned for this project from each app's own App Store description.",
  "retrieved": "2026-09-23",
  "sources": [
    "https://itunes.apple.com/lookup (Apple iTunes Search/Lookup API; per-app URL in each entry)",
    "https://nixdell.com/papers/spyware.pdf (Chatterjee et al., \"The Spyware Used in Intimate Partner Violence\", IEEE S&P 2018: most IPS-relevant apps are dual-use child-safety or anti-theft apps)",
    "https://github.com/AssoEchap/stalkerware-indicators (echap_family: the same brand or its servers appear in the Echap network indicators pinned in iocs/network.json)"
  ],
  "categories": {
    "location_sharing": "Family or friend location sharing. Shows where this phone is to the people in the group.",
    "couple_tracker": "Relationship app that shares a partner's location or arrivals.",
    "parental_control": "Parental control or child monitoring. Can show location, apps, browsing, or messages to the controlling account.",
    "anti_theft_remote": "Anti-theft or remote-device app. Can locate the phone or use its camera/microphone remotely.",
    "monitoring_marketed": "App Store app that markets itself as phone monitoring or tracking of another person."
  },
  "roles": {
    "monitored_device": "Companion app meant for the phone being watched.",
    "monitoring_device": "Controller app for the person doing the watching.",
    "both": "Same app on both sides; everyone in the group can see each other.",
    "unknown": "The same app can be either side."
  },
